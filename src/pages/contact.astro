---
import MainLayout from '../layouts/MainLayout.astro';
import { CONTACT_EMAIL } from '../consts';
---

<MainLayout title="Contact | BitsOf LLC" description="Get in touch with BitsOf LLC. We build client websites, agent harnesses, and apps/tools.">
	<div class="max-w-screen-xl mx-auto py-16 md:py-24">
		<div class="max-w-2xl mx-auto text-center mb-12">
			<h1 class="text-4xl md:text-6xl font-bold text-white mb-6">Let's Connect</h1>
			<p class="text-xl text-gray-400">
				Have a project in mind? Want to chat about what we're building? Drop a message.
			</p>
		</div>
		
		<div class="max-w-xl mx-auto">
			<form 
				action="https://formspree.io/f/placeholder" 
				method="POST"
				class="space-y-6"
				id="contact-form"
			>
				<div>
					<label for="name" class="block text-sm font-medium text-gray-300 mb-2">Name</label>
					<input 
						type="text" 
						name="name" 
						id="name" 
						required
						class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 transition-colors"
						placeholder="Your name"
					/>
				</div>
				<div>
					<label for="email" class="block text-sm font-medium text-gray-300 mb-2">Email</label>
					<input 
						type="email" 
						name="email" 
						id="email" 
						required
						class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 transition-colors"
						placeholder="you@example.com"
					/>
				</div>
				<div>
					<label for="message" class="block text-sm font-medium text-gray-300 mb-2">Message</label>
					<textarea 
						name="message" 
						id="message" 
						rows="5"
						required
						class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 transition-colors resize-none"
						placeholder="Tell me about your project..."
					></textarea>
				</div>
				<button 
					type="submit"
					class="w-full px-6 py-4 bg-gradient-to-r from-violet-500 to-purple-600 text-white font-semibold rounded-lg hover:from-violet-600 hover:to-purple-700 transition-all"
				>
					Send Message
				</button>
			</form>
			
			<div class="mt-8 pt-8 border-t border-gray-800 text-center">
				<p class="text-gray-400 mb-4">Or email directly:</p>
				<a 
					href={`mailto:${CONTACT_EMAIL}`}
					class="inline-flex items-center gap-2 text-lg text-purple-400 hover:text-purple-300 transition-colors"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
					{CONTACT_EMAIL}
				</a>
			</div>
			
			<div class="mt-8 p-4 rounded-lg bg-amber-900/20 border border-amber-700/50">
				<p class="text-amber-400 text-sm text-center">
					<strong>Note:</strong> The contact form requires a Formspree endpoint. 
					<a href="https://formspree.io" target="_blank" rel="noopener" class="underline hover:text-amber-300">Set up a free form</a> 
					and replace the placeholder in the form action. The mailto link works now.
				</p>
			</div>
		</div>
		
		<div class="mt-16 pt-16 border-t border-gray-800">
			<div class="text-center">
				<a href="/" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
					Back to Home
				</a>
			</div>
		</div>
	</div>
</MainLayout>
