---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CONTACT_EMAIL } from '../consts';

const services = [
	{
		title: 'Agent Pipelines',
		description: 'AI agent harnesses and automation systems that actually ship. We build the scaffolding, orchestration, and reliability layers so your agents can run in production—not just demos.'
	},
	{
		title: 'Data Pipelines',
		description: 'Production-grade data engineering at scale. Flink, Spark, Kubernetes—we build the infrastructure that moves and transforms your data reliably, whether you\'re processing gigabytes or petabytes.'
	},
	{
		title: 'Visualization Pipelines',
		description: 'Dashboards and data visualization that surface what matters. We connect your data infrastructure to clear, actionable interfaces your team will actually use.'
	},
	{
		title: 'Frontend & Websites',
		description: 'Web experiences that help you gain users, drive sales, and deliver value to your customers. Modern, fast, and built to convert visitors into results.'
	}
];

const portfolio = [
	{
		name: 'YapDo',
		url: 'https://yapdo.xyz',
		description: 'AI-powered task management with voice capture and intelligent prioritization'
	},
	{
		name: 'YapSpan',
		url: 'https://yapspan.com',
		description: 'Health analytics platform with personalized insights from published research'
	},
	{
		name: 'YapLearn',
		url: 'https://yaplearn.xyz',
		description: 'AI language learning with personalized lesson plans across 12 languages'
	}
];
---

<MainLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="max-w-screen-xl mx-auto">
		<section class="min-h-[70vh] flex flex-col justify-center py-16 md:py-24">
			<div class="mb-6">
				<span class="inline-block px-4 py-2 text-sm font-medium text-gray-400 border border-gray-700 rounded-full">
					BitsOf LLC — Contract Engineering
				</span>
			</div>
			<h1 class="text-5xl md:text-7xl font-bold mb-6 leading-[1.1]">
				<span class="block text-white">Agent, Data &</span>
				<span class="block text-white">Visualization Pipelines</span>
			</h1>
			<p class="text-xl md:text-2xl text-gray-400 max-w-3xl mb-12 leading-relaxed">
				We build the production infrastructure behind AI agents, data systems, and dashboards. Engineering expertise from Apple and PlayStation, applied to your hardest pipeline problems.
			</p>
			<div>
				<a 
					href={`mailto:${CONTACT_EMAIL}`}
					class="inline-flex items-center gap-3 px-8 py-4 bg-white text-black text-lg font-semibold rounded-lg hover:bg-gray-200 transition-colors"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
					{CONTACT_EMAIL}
				</a>
			</div>
		</section>

		<section id="services" class="py-20 border-t border-gray-800">
			<div class="mb-16">
				<h2 class="text-3xl md:text-4xl font-bold text-white mb-4">What We Build</h2>
				<p class="text-lg text-gray-400 max-w-2xl">Four core competencies. One goal: reliable systems that run in production.</p>
			</div>
			
			<div class="grid md:grid-cols-2 gap-6">
				{services.map((service, index) => (
					<div class="p-8 rounded-2xl border border-gray-800">
						<div class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-gray-700 text-white font-semibold mb-6">
							{index + 1}
						</div>
						<h3 class="text-xl font-bold text-white mb-3">{service.title}</h3>
						<p class="text-gray-400 leading-relaxed">{service.description}</p>
					</div>
				))}
			</div>
		</section>

		<section id="approach" class="py-20 border-t border-gray-800">
			<div class="mb-16">
				<h2 class="text-3xl md:text-4xl font-bold text-white mb-4">How We Work</h2>
				<p class="text-lg text-gray-400 max-w-2xl">Straightforward engagements. No surprises.</p>
			</div>
			
			<div class="grid md:grid-cols-2 gap-12">
				<div>
					<div class="flex items-center gap-4 mb-4">
						<span class="flex-shrink-0 w-8 h-8 rounded-full border border-gray-700 text-white flex items-center justify-center font-semibold text-sm">1</span>
						<h3 class="text-xl font-semibold text-white">Scope the Problem</h3>
					</div>
					<p class="text-gray-400 ml-12">We start with a conversation about what you're trying to build and where you're stuck. No sales pitch—just figuring out if there's a fit.</p>
				</div>
				<div>
					<div class="flex items-center gap-4 mb-4">
						<span class="flex-shrink-0 w-8 h-8 rounded-full border border-gray-700 text-white flex items-center justify-center font-semibold text-sm">2</span>
						<h3 class="text-xl font-semibold text-white">Define the Work</h3>
					</div>
					<p class="text-gray-400 ml-12">Clear deliverables, timeline, and pricing before we start. You know exactly what you're getting and when.</p>
				</div>
				<div>
					<div class="flex items-center gap-4 mb-4">
						<span class="flex-shrink-0 w-8 h-8 rounded-full border border-gray-700 text-white flex items-center justify-center font-semibold text-sm">3</span>
						<h3 class="text-xl font-semibold text-white">Build & Ship</h3>
					</div>
					<p class="text-gray-400 ml-12">We do the work. Regular updates, working code, documentation. No black boxes.</p>
				</div>
				<div>
					<div class="flex items-center gap-4 mb-4">
						<span class="flex-shrink-0 w-8 h-8 rounded-full border border-gray-700 text-white flex items-center justify-center font-semibold text-sm">4</span>
						<h3 class="text-xl font-semibold text-white">Hand Off</h3>
					</div>
					<p class="text-gray-400 ml-12">Your team owns the result. We transfer knowledge, answer questions, and make sure you can maintain what we built.</p>
				</div>
			</div>
		</section>

		<section id="background" class="py-20 border-t border-gray-800">
			<div class="mb-16">
				<h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Background</h2>
				<p class="text-lg text-gray-400 max-w-2xl">Engineering experience from companies that don't tolerate downtime.</p>
			</div>
			
			<div class="grid md:grid-cols-2 gap-8 mb-16">
				<div class="p-6 rounded-xl border border-gray-800">
					<div class="flex items-center gap-4 mb-4">
						<div class="w-10 h-10 rounded-lg border border-gray-700 flex items-center justify-center">
							<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path></svg>
						</div>
						<div>
							<h3 class="font-semibold text-white">Apple</h3>
							<p class="text-sm text-gray-500">Data & Infrastructure Engineering</p>
						</div>
					</div>
					<p class="text-gray-400 text-sm">Large-scale data pipelines and infrastructure supporting billions of users.</p>
				</div>
				<div class="p-6 rounded-xl border border-gray-800">
					<div class="flex items-center gap-4 mb-4">
						<div class="w-10 h-10 rounded-lg border border-gray-700 flex items-center justify-center">
							<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
						</div>
						<div>
							<h3 class="font-semibold text-white">PlayStation</h3>
							<p class="text-sm text-gray-500">Platform Engineering</p>
						</div>
					</div>
					<p class="text-gray-400 text-sm">Backend systems and data infrastructure for global gaming platform.</p>
				</div>
			</div>

			<div>
				<h3 class="text-xl font-semibold text-white mb-6">Built by Us</h3>
				<div class="grid md:grid-cols-3 gap-4">
					{portfolio.map((project) => (
						<a 
							href={project.url}
							target="_blank"
							rel="noopener noreferrer"
							class="group p-5 rounded-xl border border-gray-800 hover:border-gray-600 transition-colors"
						>
							<div class="flex items-center gap-2 mb-2">
								<h4 class="font-semibold text-white">{project.name}</h4>
								<svg class="w-4 h-4 text-gray-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
							</div>
							<p class="text-sm text-gray-500">{project.description}</p>
						</a>
					))}
				</div>
			</div>
		</section>

		<section id="contact" class="py-20 border-t border-gray-800">
			<div class="max-w-2xl mx-auto text-center">
				<h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Let's Talk</h2>
				<p class="text-lg text-gray-400 mb-10">
					Have a pipeline problem? Tell us what you're working on.
				</p>
				<a 
					href={`mailto:${CONTACT_EMAIL}`}
					class="inline-flex items-center gap-3 px-8 py-4 bg-white text-black text-lg font-semibold rounded-lg hover:bg-gray-200 transition-colors"
				>
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
					{CONTACT_EMAIL}
				</a>
			</div>
		</section>
	</div>
</MainLayout>
