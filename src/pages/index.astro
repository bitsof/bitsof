---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CONTACT_EMAIL } from '../consts';

const products = [
	{
		name: 'YapDo',
		url: 'https://yapdo.xyz',
		tagline: 'You know what to do. You just don\'t start.',
		description: 'Dump the whole mess in. Ask YapDo what to do next. Do that. See what you actually got done. No system to maintain—just capture, ask, and review.',
		features: ['Voice & text capture', 'AI-powered task prioritization', 'Daily accomplishment receipts'],
		gradient: 'from-violet-500 to-purple-600',
		icon: '✓'
	},
	{
		name: 'YapSpan',
		url: 'https://yapspan.com',
		tagline: 'Live 10 years longer.',
		description: 'Using the habits research shows add years. A free quiz estimates your lifespan and biological age in about 5 minutes, showing which habit would add the most years.',
		features: ['32-question life quiz', '40,000+ social views', 'Published study figures'],
		gradient: 'from-emerald-500 to-teal-600',
		icon: '♥'
	},
	{
		name: 'YapLearn',
		url: 'https://yaplearn.xyz',
		tagline: 'Learn any language using AI.',
		description: 'Personalized learning plans for your level and goal. Listen, write, build vocabulary and talk it out in short lessons that feel like a game.',
		features: ['12 languages', 'AI-built lesson plans', 'Gamified with XP & maps'],
		gradient: 'from-amber-500 to-orange-600',
		icon: '🌍'
	}
];

const services = [
	{
		title: 'Agent Harnesses',
		description: 'Custom AI agent architectures that plug into your workflows. We build the scaffolding so your agents can actually ship.',
		icon: '⚡'
	},
	{
		title: 'Client Websites',
		description: 'Modern, fast websites built with the latest frameworks. Performance-optimized and designed to convert.',
		icon: '🌐'
	},
	{
		title: 'Apps & Tools',
		description: 'Bespoke applications and productivity tools. From concept to launch, we build what you need.',
		icon: '🛠'
	}
];
---

<MainLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="max-w-screen-xl mx-auto">
		<section class="min-h-[70vh] flex flex-col justify-center py-16 md:py-24">
			<div class="mb-8">
				<span class="inline-block px-4 py-2 text-sm font-medium text-gray-400 border border-gray-700 rounded-full mb-6">
					Jeff Do's Contract Studio
				</span>
			</div>
			<h1 class="text-6xl md:text-8xl font-bold mb-6 leading-[0.9]">
				<span class="block text-white">Building</span>
				<span class="block bg-gradient-to-r from-violet-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">What's Next</span>
			</h1>
			<p class="text-xl md:text-2xl text-gray-400 max-w-2xl mb-12 leading-relaxed">
				We build client websites, agent harnesses, and apps/tools. Products that help people do the right things, at the right times, better and faster.
			</p>
			<div class="flex flex-wrap gap-4">
				<a href="#products" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-black font-semibold rounded-lg hover:bg-gray-200 transition-colors">
					See Our Work
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
				</a>
				<a href="#contact" class="inline-flex items-center gap-2 px-6 py-3 border border-gray-600 text-white font-semibold rounded-lg hover:border-white transition-colors">
					Get in Touch
				</a>
			</div>
		</section>

		<section id="products" class="py-20 border-t border-gray-800">
			<div class="mb-16">
				<h2 class="text-4xl md:text-5xl font-bold text-white mb-4">Products</h2>
				<p class="text-xl text-gray-400 max-w-2xl">Tools we've built to help people get more done.</p>
			</div>
			
			<div class="grid gap-8">
				{products.map((product) => (
					<a 
						href={product.url} 
						target="_blank" 
						rel="noopener noreferrer"
						class="group block p-8 md:p-10 rounded-2xl border border-gray-800 bg-gray-900/50 hover:border-gray-600 hover:bg-gray-900 transition-all duration-300"
					>
						<div class="flex flex-col md:flex-row md:items-start gap-6">
							<div class={`flex-shrink-0 w-16 h-16 rounded-xl bg-gradient-to-br ${product.gradient} flex items-center justify-center text-2xl`}>
								{product.icon}
							</div>
							<div class="flex-1">
								<div class="flex items-center gap-3 mb-2">
									<h3 class="text-2xl md:text-3xl font-bold text-white group-hover:text-gray-100">{product.name}</h3>
									<svg class="w-5 h-5 text-gray-500 group-hover:text-white group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
								</div>
								<p class="text-lg text-purple-400 font-medium mb-3">{product.tagline}</p>
								<p class="text-gray-400 mb-4 leading-relaxed">{product.description}</p>
								<div class="flex flex-wrap gap-2">
									{product.features.map((feature) => (
										<span class="px-3 py-1 text-sm text-gray-300 bg-gray-800 rounded-full">{feature}</span>
									))}
								</div>
							</div>
						</div>
					</a>
				))}
			</div>
			
			<div class="mt-12 p-6 rounded-xl border border-dashed border-gray-700 bg-gray-900/30">
				<div class="flex items-center gap-4">
					<div class="w-12 h-12 rounded-lg bg-gray-800 flex items-center justify-center text-xl">🚀</div>
					<div>
						<h4 class="text-lg font-semibold text-white">DoMore</h4>
						<p class="text-gray-500">Coming soon — more tools in the works.</p>
					</div>
				</div>
			</div>
		</section>

		<section id="services" class="py-20 border-t border-gray-800">
			<div class="mb-16">
				<h2 class="text-4xl md:text-5xl font-bold text-white mb-4">Services</h2>
				<p class="text-xl text-gray-400 max-w-2xl">What we build for clients.</p>
			</div>
			
			<div class="grid md:grid-cols-3 gap-6">
				{services.map((service) => (
					<div class="p-8 rounded-2xl border border-gray-800 bg-gray-900/50 hover:border-gray-700 transition-colors">
						<div class="text-3xl mb-4">{service.icon}</div>
						<h3 class="text-xl font-bold text-white mb-3">{service.title}</h3>
						<p class="text-gray-400 leading-relaxed">{service.description}</p>
					</div>
				))}
			</div>
		</section>

		<section id="contact" class="py-20 border-t border-gray-800">
			<div class="max-w-2xl mx-auto text-center mb-12">
				<h2 class="text-4xl md:text-5xl font-bold text-white mb-4">Let's Connect</h2>
				<p class="text-xl text-gray-400">
					Have a project in mind? Want to chat about what we're building? Drop a message.
				</p>
			</div>
			
			<div class="max-w-xl mx-auto">
				<form 
					action="https://formspree.io/f/placeholder" 
					method="POST"
					class="space-y-6"
					id="contact-form"
				>
					<div>
						<label for="name" class="block text-sm font-medium text-gray-300 mb-2">Name</label>
						<input 
							type="text" 
							name="name" 
							id="name" 
							required
							class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 transition-colors"
							placeholder="Your name"
						/>
					</div>
					<div>
						<label for="email" class="block text-sm font-medium text-gray-300 mb-2">Email</label>
						<input 
							type="email" 
							name="email" 
							id="email" 
							required
							class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 transition-colors"
							placeholder="you@example.com"
						/>
					</div>
					<div>
						<label for="message" class="block text-sm font-medium text-gray-300 mb-2">Message</label>
						<textarea 
							name="message" 
							id="message" 
							rows="5"
							required
							class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 transition-colors resize-none"
							placeholder="Tell me about your project..."
						></textarea>
					</div>
					<button 
						type="submit"
						class="w-full px-6 py-4 bg-gradient-to-r from-violet-500 to-purple-600 text-white font-semibold rounded-lg hover:from-violet-600 hover:to-purple-700 transition-all"
					>
						Send Message
					</button>
				</form>
				
				<div class="mt-8 pt-8 border-t border-gray-800 text-center">
					<p class="text-gray-400 mb-4">Or email directly:</p>
					<a 
						href={`mailto:${CONTACT_EMAIL}`}
						class="inline-flex items-center gap-2 text-lg text-purple-400 hover:text-purple-300 transition-colors"
					>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
						{CONTACT_EMAIL}
					</a>
				</div>
				
				<div class="mt-8 p-4 rounded-lg bg-amber-900/20 border border-amber-700/50">
					<p class="text-amber-400 text-sm text-center">
						<strong>Note:</strong> The contact form requires a Formspree endpoint. 
						<a href="https://formspree.io" target="_blank" rel="noopener" class="underline hover:text-amber-300">Set up a free form</a> 
						and replace the placeholder in the form action. The mailto link works now.
					</p>
				</div>
			</div>
		</section>
	</div>
</MainLayout>
